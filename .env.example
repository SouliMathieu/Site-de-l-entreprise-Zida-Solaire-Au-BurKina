# Database
DATABASE_URL="postgresql://user:password@localhost:5432/zida"

# Required for admin and customer JWT signing, and OTP hashing.
# Use a long random secret in every deployed environment.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# OTP provider: orange | webhook
# If omitted outside production, the backend uses a development-only OTP mode.
SMS_OTP_PROVIDER="orange"

# Orange Developer - SMS Burkina Faso
# Create an application, subscribe to SMS Burkina Faso and purchase a bundle.
ORANGE_SMS_CLIENT_ID=""
ORANGE_SMS_CLIENT_SECRET=""
# Orange Burkina country sender number documented by Orange Developer.
ORANGE_SMS_SENDER_NUMBER="2260000"
# Optional approved/whitelisted sender name, max 11 alphanumeric characters/spaces.
ORANGE_SMS_SENDER_NAME="ZIDA SOLAIRE"

# Generic webhook fallback (used when SMS_OTP_PROVIDER=webhook)
# ZIDA sends JSON: { "phone": "+22670000000", "message": "...", "code": "123456" }
SMS_OTP_WEBHOOK_URL=""
SMS_OTP_WEBHOOK_TOKEN=""

# Existing email configuration
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
ADMIN_EMAIL=""
ADMIN_PANEL_URL=""
