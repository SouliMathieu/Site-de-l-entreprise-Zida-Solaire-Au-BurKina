# Database
DATABASE_URL="postgresql://user:password@localhost:5432/zida"

# Required for admin and customer JWT signing, and OTP hashing.
# Use a long random secret in every deployed environment.
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# OTP SMS gateway
# ZIDA expects a POST endpoint accepting JSON:
# { "phone": "+22670000000", "message": "...", "code": "123456" }
SMS_OTP_WEBHOOK_URL=""

# Optional bearer token sent to the SMS gateway.
SMS_OTP_WEBHOOK_TOKEN=""

# Existing email configuration
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
ADMIN_EMAIL=""
ADMIN_PANEL_URL=""
